{
  "name": "@hypercarrier/ampi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AmPi: a desktop GUI and durable agent server built on pi-durable; replaces Herdr + pi-coding-agent in HyperCarrier.",
  "type": "module",
  "bin": {
    "ampi": "./bin/ampi.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node scripts/run-tests.cjs fast",
    "test:full": "npm run typecheck:agree && node scripts/run-tests.cjs full",
    "test:exhaustive-only": "node scripts/run-tests.cjs exhaustiveOnly",
    "test:lanes": "node scripts/verify-test-lanes.cjs",
    "deploy:check": "node scripts/deploy-check.cjs",
    "perf": "node scripts/perf/run.mjs",
    "typecheck": "node scripts/typecheck.cjs",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "typecheck:agree": "node scripts/typecheck.cjs --agree",
    "build:web": "vite build --config web/vite.config.ts web",
    "dev:web": "vite --config web/vite.config.ts web",
    "start": "node bin/ampi.mjs hub"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@hypercarrier/durable-compact": "0.1.0",
    "@hypercarrier/durable-rarebit": "0.1.0",
    "@hypercarrier/durable-team": "0.1.0",
    "@hypercarrier/rarebit": "^0.5.2",
    "diff": "^8.0.4",
    "marked": "^18.0.5",
    "typebox": "1.3.27",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "playwright": "1.61.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
