{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		// RarebitValue pulls backend modules into this program; hub/hosts.ts supplied Node types incidentally.
		// Drop Node types when RarebitValue moves to shared/.
		"types": ["vite/client", "node"]
	},
	"include": ["src"]
}
