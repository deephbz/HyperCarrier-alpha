{
  "name": "hypercarrier-alpha",
  "version": "0.1.0-alpha.7",
  "description": "A local-first control plane for Pi, tmux, Project evidence, and agent-assisted work.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "ajv": "^6.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "!packages/pi-openai-blackmagic-compact"
  ],
  "scripts": {
    "start": "npm --workspace pi-session-timeline start",
    "start:traffic": "npm --workspace @hypercarrier/traffic-analysis start",
    "start:stack": "npm --workspace pi-session-timeline run start:stack",
    "start:better-url": "npm --workspace pi-session-timeline run start:better-url",
    "test": "npm run test:packages && npm run test:timeline && npm run test:traffic",
    "test:packages": "node --test packages/hc-auto-compact/test/*.test.mjs && npm --workspace @hypercarrier/rarebit test && npm --workspace @hypercarrier/systemp-prompt-audit test && npm --workspace @hypercarrier/pi-ttl-backtester test",
    "test:timeline": "npm --workspace pi-session-timeline test",
    "test:release": "node --test scripts/test/export*.test.mjs scripts/test/public-workflow-closure.test.mjs",
    "test:traffic": "npm --workspace @hypercarrier/traffic-analysis test",
    "test:composition": "node --test --test-concurrency=1 scripts/test/verify-composition.test.mjs scripts/test/verify-colorstack-composition.test.mjs scripts/test/compose-terminal-theme-candidate.test.mjs",
    "verify:composition": "node scripts/verify-composition.mjs",
    "verify:colorstack": "node scripts/verify-colorstack-composition.mjs",
    "compose:terminal-theme": "node scripts/compose-terminal-theme-candidate.mjs",
    "build:timeline": "npm --workspace pi-session-timeline run build:web",
    "build:traffic": "npm --workspace @hypercarrier/traffic-analysis run build"
  }
}
