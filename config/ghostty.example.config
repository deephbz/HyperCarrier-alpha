# Complete macOS behavior/keybinding example. Merge with existing preferences.
font-family = Iosevka
font-size = 14
window-padding-x = 8
window-padding-y = 6
macos-option-as-alt = true
confirm-close-surface = false

# Reuse the current macOS window for standard new-terminal shortcuts.
keybind = super+n=unbind
keybind = super+n=new_tab

# Pass Cmd+F through so Herdr can zoom the active pane.
keybind = super+f=unbind

# Send Cmd+Enter as Alt+Enter; Pi uses Alt+Enter for queued follow-up messages.
keybind = super+enter=unbind
keybind = super+enter=text:\x1b\r

# Translate Cmd+h/j/k/l to Herdr's tmux-style Ctrl+b pane bindings.
keybind = super+h=text:\x02h
keybind = super+j=text:\x02j
keybind = super+k=text:\x02k
keybind = super+l=text:\x02l

# Cmd+[ / Cmd+] navigate tmux windows.
keybind = super+[=unbind
keybind = super+]=unbind
keybind = super+[=text:\x02p
keybind = super+]=text:\x02n
