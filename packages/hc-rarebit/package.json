{
  "name": "@hypercarrier/hc-rarebit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A narrow, provenance-bearing complete Rarebit projection for Pi sessions.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "types": "./src/types.d.ts",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e:summary-cache": "node scripts/e2e-summary-cache.mjs"
  },
  "bin": {
    "hc-rarebit": "./bin/hc-rarebit.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10"
  },
  "devDependencies": {
    "ajv": "^6.15.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.mjs"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./src/index.mjs"
    },
    "./core": "./src/rarebit-core.mjs",
    "./session": "./src/rarebit-session.mjs",
    "./service": "./src/rarebit-service.mjs",
    "./artifact-state": "./src/rarebit-artifact-state.mjs",
    "./visual-language": "./src/rarebit-visual-language.mjs",
    "./extension": "./src/extension.mjs",
    "./types": "./src/types.d.ts"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "README.md",
    "RUNBOOK.md",
    "VISUAL-LANGUAGE.md"
  ]
}
