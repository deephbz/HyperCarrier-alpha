{
  "name": "@hypercarrier/hc-auto-compact",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Cooperative handoff around Pi's native context compaction lifecycle.",
  "keywords": [
    "pi-package",
    "compaction"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs sim/*.test.mjs",
    "test:sim": "node --test sim/*.test.mjs",
    "test:sim:campaign": "HC_PI_SIM_RUNS=100 node --test sim/*.test.mjs",
    "test:e2e": "node scripts/e2e-rpc.mjs"
  },
  "dependencies": {
    "@hypercarrier/rarebit": "0.6.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@hypercarrier/pi-sim": "0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/extension.mjs"
    ]
  },
  "exports": {
    ".": "./src/index.mjs",
    "./command": "./src/command.mjs",
    "./controller": "./src/controller.mjs",
    "./settings": "./src/settings.mjs",
    "./extension": "./src/extension.mjs"
  },
  "files": [
    "src",
    "README.md"
  ]
}
