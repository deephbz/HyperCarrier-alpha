{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypercarrier.local/schemas/output-summary-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "type",
    "eventId",
    "summaryId",
    "projectId",
    "sessionId",
    "observedAt",
    "validAt",
    "window",
    "model",
    "promptVersion",
    "derivationVersion",
    "inputHash",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "output_summary" },
    "status": { "enum": ["ok", "insufficient_window", "failure", "conflict"] },
    "projectId": { "type": ["string", "null"] },
    "observedAt": { "type": "string" },
    "validAt": { "type": ["string", "null"] },
    "retryable": { "type": "boolean" },
    "attemptId": { "type": "string", "minLength": 1 },
    "materializationId": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "window": {
      "type": "object",
      "required": [
        "n",
        "selectedMessageIds",
        "selectedMessages",
        "asOf",
        "complete"
      ],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "selectedMessageIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selectedMessages": { "type": "array" },
        "asOf": { "type": ["string", "null"] },
        "complete": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string" },
        "id": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
