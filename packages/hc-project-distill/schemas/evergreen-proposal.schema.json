{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypercarrier.local/schemas/evergreen-proposal-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "type",
    "status",
    "proposalId",
    "projectId",
    "baseHash",
    "sourceFrontierHash",
    "artifactHashes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "evergreen_proposal" },
    "status": { "const": "proposed" },
    "proposalId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,127})$"
    },
    "baseHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceFrontierHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactHashes": {
      "type": "object",
      "required": ["markdown", "patch"],
      "properties": {
        "markdown": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "patch": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "additionalProperties": true
}
