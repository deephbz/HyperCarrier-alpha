{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypercarrier.local/schemas/project-registry-v1.json",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "projects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryVersion": { "type": "string", "minLength": 1 },
    "correctionProvenance": { "type": "object" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "locations", "associations"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,127})$"
          },
          "name": { "type": "string", "minLength": 1 },
          "locations": {
            "type": "object",
            "required": [
              "repos",
              "evergreen",
              "beadsRoot",
              "summaries",
              "events",
              "proposalDir"
            ],
            "properties": {
              "repos": { "type": "array", "items": { "type": "string" } },
              "evergreen": { "type": ["string", "null"] },
              "beadsRoot": { "type": ["string", "null"] },
              "summaries": { "type": "array", "items": { "type": "string" } },
              "events": { "type": ["string", "null"] },
              "proposalDir": { "type": ["string", "null"] },
              "sourceDocs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "associations": {
            "type": "object",
            "properties": {
              "sessionIds": { "type": "array", "items": { "type": "string" } },
              "taskIds": { "type": "array", "items": { "type": "string" } },
              "rules": { "type": "array", "items": { "type": "object" } }
            }
          },
          "evergreen": {
            "type": "object",
            "properties": {
              "baseHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
