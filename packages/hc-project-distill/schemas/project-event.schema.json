{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypercarrier.local/schemas/project-event-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "type",
    "eventId",
    "projectId",
    "eventKind",
    "at",
    "sources",
    "sourceFrontierHash",
    "derivationVersion",
    "idempotencyKey",
    "payload",
    "observedAt",
    "validAt",
    "sourceFact"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "project_event" },
    "eventId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,127})$"
    },
    "eventKind": {
      "enum": [
        "progress",
        "finding",
        "decision-candidate",
        "conflict",
        "retirement",
        "delivery-evidence"
      ]
    },
    "at": { "type": ["string", "null"] },
    "sources": { "type": "array" },
    "payload": {
      "type": "object",
      "oneOf": [
        { "required": ["task"] },
        { "required": ["commit"] },
        { "required": ["reportedSummary"] }
      ]
    },
    "observedAt": { "type": "string" },
    "validAt": { "type": ["string", "null"] },
    "sourceFact": { "type": "object", "required": ["kind", "id", "version"] }
  },
  "additionalProperties": true
}
